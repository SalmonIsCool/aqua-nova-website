---
import "../styles/global.css";
import { siteConfig } from "../data/site";
import HubSidebar from "../components/hub/HubSidebar.astro";
import HubTopBar from "../components/hub/HubTopBar.astro";

interface Breadcrumb {
  label: string;
  href?: string;
}

interface Props {
  title: string;
  breadcrumbs?: Breadcrumb[];
  requireAuth?: boolean;
  fullWidth?: boolean;
}

const { title, requireAuth = true, fullWidth = false } = Astro.props;
const breadcrumbs = Astro.props.breadcrumbs ?? [{ label: "Home", href: "/hub/" }, { label: title }];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/assets/logo.png" type="image/png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet" />
    <title>{title} | {siteConfig.name} Hub</title>
  </head>
  <body class="hub-body" data-require-auth={requireAuth ? "true" : "false"}>
    {
      requireAuth ? (
        <div class="hub-shell">
          <HubSidebar />
          <div class="hub-main">
            <HubTopBar breadcrumbs={breadcrumbs} />
            <div class:list={["hub-content", { "hub-content--full": fullWidth }]}>
              <slot />
            </div>
            <footer class="hub-footer">
              Copyright {new Date().getFullYear()} © {siteConfig.name}
            </footer>
          </div>
        </div>
      ) : (
        <main class="hub-login-shell">
          <slot />
        </main>
      )
    }

    <script is:inline src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
    <script>
      import { getAuthHeadersAsync, onIdentityReady, setupHubRouteGuard } from "../scripts/hub-auth";
      import { startLiveRefresh } from "../scripts/live-fetch";

      const requireAuth = document.body.dataset.requireAuth === "true";
      setupHubRouteGuard(requireAuth);

      function setHubAvatar(element: HTMLElement | null, name: string, avatarUrl?: string | null) {
        if (!element) return;
        const initial = name.charAt(0).toUpperCase() || "?";

        if (avatarUrl) {
          element.innerHTML = `<img src="${avatarUrl}" alt="" width="40" height="40" loading="lazy" referrerpolicy="no-referrer" />`;
          return;
        }

        element.textContent = initial;
      }

      function setHubProfile(name: string, avatarUrl?: string | null) {
        document.getElementById("hub-sidebar-name")!.textContent = name;
        setHubAvatar(document.getElementById("hub-sidebar-avatar"), name, avatarUrl);
        setHubAvatar(document.getElementById("hub-topbar-avatar"), name, avatarUrl);
      }

      async function loadHubProfile() {
        try {
          const response = await fetch(`/api/my-stats?_=${Date.now()}`, {
            headers: await getAuthHeadersAsync(),
            cache: "no-store"
          });
          const data = await response.json();
          if (response.ok && data.driver?.name) {
            setHubProfile(data.driver.name, data.driver.avatarUrl);
            if (data.rank?.currentName) {
              const rankEl = document.getElementById("hub-sidebar-rank");
              if (rankEl) {
                rankEl.textContent = data.rank.currentName;
                if (data.rank.currentColor) rankEl.style.color = data.rank.currentColor;
              }
            }
            return;
          }
        } catch {
          /* fall through */
        }

        const user = window.netlifyIdentity?.currentUser();
        if (user?.email) {
          const fallback = user.email.split("@")[0] ?? "Driver";
          setHubProfile(fallback);
        }
      }

      onIdentityReady((user) => {
        if (!user || !requireAuth) return;
        loadHubProfile();
        startLiveRefresh(loadHubProfile);
      });

      document.getElementById("hub-logout")?.addEventListener("click", () => {
        window.netlifyIdentity?.logout();
        window.location.href = "/hub/login";
      });

      window.netlifyIdentity?.on("init", (user) => {
        const hash = window.location.hash || "";
        if (!user && (hash.includes("invite_token") || hash.includes("confirmation_token"))) {
          window.netlifyIdentity?.open("signup");
        }
      });
    </script>
  </body>
</html>
