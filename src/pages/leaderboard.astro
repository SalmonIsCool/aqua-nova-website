---
import BaseLayout from "../layouts/BaseLayout.astro";
import LeaderboardControls from "../components/LeaderboardControls.astro";
import { siteConfig } from "../data/site";

const now = new Date();
const currentMonth = now.getMonth() + 1;
const currentYear = now.getFullYear();
---

<BaseLayout title={`${siteConfig.name} | Leaderboard`}>
  <section class="section-shell-wide">
    <h1 class="section-title">Driver leaderboard</h1>
    <p class="mt-3 max-w-2xl text-base text-slate-300 sm:text-lg">
      Live rankings from Trucky VTC Hub — distance, jobs, and revenue for Aqua Nova drivers. Each driver shows
      their VTC role and current driver rank.
    </p>

    <div class="mt-8">
      <LeaderboardControls currentMonth={currentMonth} currentYear={currentYear} />
    </div>

    <div id="leaderboard-status" class="mt-6 text-sm text-slate-400">Loading leaderboard…</div>

    <div class="panel mt-4 overflow-x-auto p-0">
      <table class="w-full min-w-[44rem] text-left text-sm">
        <thead class="border-b border-white/10 bg-[#0a2a8a]/40 text-slate-300">
          <tr>
            <th class="px-4 py-3 font-semibold">Rank</th>
            <th class="px-4 py-3 font-semibold">Driver</th>
            <th class="px-4 py-3 font-semibold">Distance</th>
            <th class="px-4 py-3 font-semibold">Jobs</th>
            <th class="px-4 py-3 font-semibold">Revenue</th>
          </tr>
        </thead>
        <tbody id="leaderboard-body" class="divide-y divide-white/10"></tbody>
      </table>
    </div>
  </section>
</BaseLayout>

<script>
  import { initLeaderboardPage } from "../scripts/leaderboard-page";

  initLeaderboardPage({
    statusId: "leaderboard-status",
    bodyId: "leaderboard-body",
    periodId: "leaderboard-period",
    monthId: "leaderboard-month",
    yearId: "leaderboard-year",
    sortId: "leaderboard-sort",
    refreshId: "leaderboard-refresh"
  });
</script>
