---
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteConfig } from "../data/site";
---

<BaseLayout title={`${siteConfig.name} | Contact`}>
  <section class="section-shell-wide">
    <h1 class="section-title">Contact & support</h1>
    <p class="mt-3 max-w-2xl text-base text-slate-300 sm:text-lg">
      Need help, partnership details, or event coordination? Send us a message.
    </p>

    <form
      name="contact"
      method="POST"
      data-netlify="true"
      netlify-honeypot="bot-field"
      class="panel mx-auto mt-10 grid max-w-2xl gap-5"
    >
      <input type="hidden" name="form-name" value="contact" />
      <p class="hidden">
        <label>
          Do not fill this out if you are human: <input name="bot-field" />
        </label>
      </p>

      <label class="grid gap-2">
        <span class="text-sm font-medium text-slate-300">Name</span>
        <input required name="name" class="input-field" />
      </label>

      <label class="grid gap-2">
        <span class="text-sm font-medium text-slate-300">Email</span>
        <input required type="email" name="email" class="input-field" />
      </label>

      <label class="grid gap-2">
        <span class="text-sm font-medium text-slate-300">Message</span>
        <textarea required name="message" rows="6" class="input-field"></textarea>
      </label>

      <button type="submit" class="btn-primary w-full sm:w-fit">Send message</button>
    </form>
  </section>
</BaseLayout>
