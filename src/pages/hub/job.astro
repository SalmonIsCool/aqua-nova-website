---
import HubLayout from "../../layouts/HubLayout.astro";
---

<HubLayout
  title="Job details"
  breadcrumbs={[
    { label: "Home", href: "/hub/" },
    { label: "Jobs", href: "/hub/jobs/mine" },
    { label: "Job details" }
  ]}
>
  <div>
    <a href="/hub/jobs/mine" class="text-sm text-cyan-300 hover:text-cyan-200">← Back to your jobs</a>
    <div id="job-root" class="mt-6">
      <p class="text-slate-400">Loading job…</p>
    </div>
  </div>
</HubLayout>

<script>
  import { getAuthHeaders, onIdentityReady } from "../../scripts/hub-auth";

  const formatter = new Intl.NumberFormat("en-GB", { maximumFractionDigits: 1 });

  const timelineEventTypes = new Set([
    "tollgate_paid",
    "transport_used",
    "fined",
    "refuel",
    "collision",
    "teleport"
  ]);

  const eventIcons: Record<string, string> = {
    tollgate_paid: "⛃",
    transport_used: "⛴",
    fined: "⚠",
    refuel: "⛽",
    collision: "💥",
    teleport: "↯"
  };

  function formatDate(value: unknown) {
    if (!value || typeof value !== "string") return "—";
    return new Date(value).toLocaleString();
  }

  function formatDistance(job: Record<string, unknown>, field: "planned" | "driven") {
    const km = field === "planned" ? job.planned_distance_km : job.driven_distance_km;
    const raw = field === "planned" ? job.planned_distance : job.driven_distance;
    const unit = String(job.distance_unit ?? "km");

    if (typeof km === "number" && km > 0) {
      return unit === "mi" ? `${formatter.format(km)} mi` : `${formatter.format(km)} km`;
    }
    if (typeof raw === "number" && raw > 0) {
      return `${formatter.format(raw)} ${unit}`;
    }
    return "—";
  }

  function formatDuration(seconds: unknown) {
    const total = Number(seconds);
    if (!total || Number.isNaN(total)) return "—";
    const mins = Math.round(total / 60);
    return `${mins} min`;
  }

  function formatFuel(job: Record<string, unknown>) {
    const liters = Number(job.fuel_used_l ?? job.fuel_used ?? 0);
    const distanceMi =
      Number(job.driven_distance_km) > 0 && job.distance_unit === "mi"
        ? Number(job.driven_distance_km)
        : Number(job.driven_distance_km) * 0.621371;

    if (!liters) return "—";

    if (distanceMi > 0) {
      const gallons = liters * 0.264172;
      const mpg = gallons > 0 ? distanceMi / gallons : 0;
      return `${formatter.format(mpg)} mpg (${formatter.format(liters)} l)`;
    }

    return `${formatter.format(liters)} l`;
  }

  function totalDamage(job: Record<string, unknown>) {
    const values = [job.vehicle_damage, job.trailers_damage, job.cargo_damage]
      .map((v) => Number(v))
      .filter((v) => !Number.isNaN(v));
    if (!values.length) return "0%";
    const max = Math.max(...values);
    return `${formatter.format(max)}%`;
  }

  function formatMarket(market: unknown) {
    if (!market) return "Job";
    return String(market).replace(/_/g, " ");
  }

  function eventLabel(event: Record<string, unknown>) {
    const type = String(event.event_type ?? "");
    if (type === "transport_used") {
      const attrs = event.attributes as Record<string, unknown> | undefined;
      const mode = attrs?.event ?? attrs?.transport ?? "transport";
      return String(mode).charAt(0).toUpperCase() + String(mode).slice(1);
    }
    if (type === "fined") {
      const attrs = event.attributes as Record<string, unknown> | undefined;
      return attrs?.offence ? `Fine (${String(attrs.offence).replace(/_/g, " ")})` : "Fine";
    }
    const labels: Record<string, string> = {
      tollgate_paid: "Tollgate",
      refuel: "Refuel",
      collision: "Collision",
      teleport: "Teleport"
    };
    return labels[type] ?? type.replace(/_/g, " ");
  }

  function layoutTimelinePositions(events: Record<string, unknown>[], job: Record<string, unknown>) {
    const start = new Date(String(job.started_at ?? job.created_at)).getTime();
    const end = new Date(String(job.completed_at ?? job.updated_at ?? job.created_at)).getTime();
    const span = Math.max(end - start, 1);
    const minGap = events.length <= 3 ? 24 : events.length <= 5 ? 16 : 12;
    const edge = 6;
    const maxLeft = 100 - edge;

    const positioned = events.map((event) => {
      const time = new Date(String(event.created_at)).getTime();
      const ideal = edge + ((time - start) / span) * (100 - edge * 2);
      return { event, left: Math.min(Math.max(ideal, edge), maxLeft) };
    });

    for (let index = 1; index < positioned.length; index += 1) {
      const previous = positioned[index - 1].left;
      if (positioned[index].left < previous + minGap) {
        positioned[index].left = previous + minGap;
      }
    }

    if (positioned.length && positioned[positioned.length - 1].left > maxLeft) {
      positioned[positioned.length - 1].left = maxLeft;
      for (let index = positioned.length - 2; index >= 0; index -= 1) {
        const next = positioned[index + 1].left;
        if (positioned[index].left > next - minGap) {
          positioned[index].left = Math.max(next - minGap, edge + index * minGap);
        }
      }
    }

    return positioned;
  }

  function renderTimeline(events: Record<string, unknown>[], job: Record<string, unknown>) {
    const filtered = events
      .filter((event) => timelineEventTypes.has(String(event.event_type)))
      .sort((a, b) => new Date(String(a.created_at)).getTime() - new Date(String(b.created_at)).getTime());

    if (!filtered.length) return "";

    const positioned = layoutTimelinePositions(filtered, job);

    const markers = positioned
      .map(({ event, left }, index) => {
        const above = index % 2 === 0;
        const type = String(event.event_type);
        const icon = eventIcons[type] ?? "•";

        const card = `<div class="job-timeline__card">
          <p class="text-slate-400">${formatDate(event.created_at)}</p>
          <p class="mt-1 font-semibold text-white">${eventLabel(event)}</p>
        </div>`;

        return `<div class="job-timeline__event" style="left: ${left.toFixed(1)}%">
          <div class="job-timeline__slot job-timeline__slot--above">${above ? card : ""}</div>
          <div class="job-timeline__marker" aria-hidden="true">${icon}</div>
          <div class="job-timeline__slot job-timeline__slot--below">${above ? "" : card}</div>
        </div>`;
      })
      .join("");

    return `<section class="job-view-card mt-6">
      <h2 class="mb-2 text-sm font-semibold uppercase tracking-wide text-slate-400">Route events</h2>
      <div class="job-timeline">
        <div class="job-timeline__track">
          <div class="job-timeline__line" aria-hidden="true"></div>
          ${markers}
        </div>
      </div>
    </section>`;
  }

  function renderJob(job: Record<string, unknown>, events: Record<string, unknown>[], driverName: string) {
    const driver = (job.driver as Record<string, unknown>) ?? {};
    const company = (job.company as Record<string, unknown>) ?? {};
    const currency = String(job.currency ?? "T¢");
    const cargoTags: string[] = [];

    if (job.auto_park === false) cargoTags.push("No auto park");
    if (job.auto_load === false) cargoTags.push("No auto load");
    if (job.market) cargoTags.push(formatMarket(job.market));

    const vehicleName = [job.vehicle_brand_name, job.vehicle_model_name].filter(Boolean).join(" ") || "—";
    const odometer = job.vehicle_odometer_end ?? job.vehicle_odometer_start;

    return `
      <section class="job-view-card flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div class="flex items-center gap-3">
          <div class="flex h-12 w-12 items-center justify-center rounded-full bg-cyan-500/20 text-lg font-bold text-cyan-200">
            ${(driverName || "D").charAt(0).toUpperCase()}
          </div>
          <div>
            <p class="text-lg font-semibold text-white">${driverName || String(driver.name ?? "Driver")}</p>
            <p class="text-sm text-slate-400">Aqua Nova driver</p>
          </div>
        </div>
        <div class="flex items-center gap-3">
          <img src="/assets/logo.png" alt="" class="h-12 w-12 rounded-full" />
          <div class="text-right">
            <p class="font-semibold text-white">${String(company.name ?? "Aqua Nova Transport")}</p>
            <p class="text-sm text-slate-400">VTC Hub</p>
          </div>
        </div>
      </section>

      <section class="mt-4 grid grid-cols-2 gap-3 lg:grid-cols-4">
        <div class="job-stat-tile">
          <span class="text-2xl">🛣</span>
          <p class="text-xl font-bold text-white">${formatDistance(job, "driven")}</p>
        </div>
        <div class="job-stat-tile">
          <span class="text-2xl">⛽</span>
          <p class="text-sm font-semibold text-white">${formatFuel(job)}</p>
        </div>
        <div class="job-stat-tile">
          <span class="text-2xl">💔</span>
          <p class="text-xl font-bold text-white">${totalDamage(job)}</p>
        </div>
        <div class="job-stat-tile">
          <span class="text-2xl">⏳</span>
          <p class="text-xl font-bold text-white">${formatDuration(job.real_driving_time_seconds)}</p>
        </div>
      </section>

      <section class="mt-4 grid gap-4 lg:grid-cols-3">
        <article class="job-view-card">
          <h3 class="text-sm font-semibold uppercase tracking-wide text-slate-400">From</h3>
          <p class="mt-2 text-2xl font-bold text-white">${job.source_city_name ?? "—"}</p>
          <p class="text-slate-300">${job.source_company_name ?? "—"}</p>
        </article>
        <article class="job-view-card">
          <h3 class="text-sm font-semibold uppercase tracking-wide text-slate-400">To</h3>
          <p class="mt-2 text-2xl font-bold text-white">${job.destination_city_name ?? "—"}</p>
          <p class="text-slate-300">${job.destination_company_name ?? "—"}</p>
        </article>
        <article class="job-view-card">
          <h3 class="text-sm font-semibold uppercase tracking-wide text-slate-400">Vehicle</h3>
          <p class="mt-2 text-2xl font-bold text-white">${vehicleName}</p>
          <p class="text-slate-300">${odometer ? `${formatter.format(Number(odometer))} ${job.distance_unit ?? "km"}` : "—"}</p>
        </article>
      </section>

      <section class="mt-4 grid gap-4 lg:grid-cols-3">
        <article class="job-view-card">
          <div class="flex flex-wrap items-center gap-2">
            <span class="job-badge job-badge--market">${formatMarket(job.market)}</span>
            ${cargoTags.map((tag) => `<span class="job-badge job-badge--tag">${tag}</span>`).join("")}
          </div>
          <p class="mt-4 text-xl font-bold text-white">${job.cargo_name ?? "—"}</p>
          <p class="text-slate-300">${job.cargo_mass_t ? `${formatter.format(Number(job.cargo_mass_t))} t` : job.cargo_mass ? `${formatter.format(Number(job.cargo_mass))} kg` : "—"}</p>
        </article>
        <article class="job-view-card">
          <h3 class="text-sm font-semibold uppercase tracking-wide text-slate-400">Distance</h3>
          <div class="mt-4 space-y-2">
            <div class="flex justify-between"><span class="text-slate-400">Planned</span><span class="font-semibold text-white">${formatDistance(job, "planned")}</span></div>
            <div class="flex justify-between"><span class="text-slate-400">Real</span><span class="font-semibold text-white">${formatDistance(job, "driven")}</span></div>
          </div>
        </article>
        <article class="job-view-card">
          <div class="flex items-center justify-between gap-2">
            <h3 class="text-sm font-semibold uppercase tracking-wide text-slate-400">Timing</h3>
            <span class="job-badge ${job.late_delivery ? "bg-rose-500/20 text-rose-300" : "job-badge--ok"}">${job.late_delivery ? "Late" : "On time"}</span>
          </div>
          <div class="mt-4 space-y-2">
            <div class="flex justify-between gap-4"><span class="text-slate-400">Started</span><span class="text-right text-white">${formatDate(job.started_at)}</span></div>
            <div class="flex justify-between gap-4"><span class="text-slate-400">Ended</span><span class="text-right text-white">${formatDate(job.completed_at ?? job.canceled_at)}</span></div>
          </div>
        </article>
      </section>

      ${renderTimeline(events, job)}

      <section class="mt-4 grid gap-4 lg:grid-cols-2">
        <article class="job-view-card">
          <h3 class="text-sm font-semibold uppercase tracking-wide text-slate-400">Finance details</h3>
          <div class="mt-4 space-y-3">
            <div class="flex justify-between"><span class="text-slate-400">Income</span><span class="job-finance-value">${job.income != null ? `${formatter.format(Number(job.income))} ${currency}` : "—"}</span></div>
            <div class="flex justify-between"><span class="text-slate-400">Revenue</span><span class="job-finance-value">${job.revenue != null ? `${formatter.format(Number(job.revenue))} ${currency}` : "—"}</span></div>
          </div>
        </article>
        <article class="job-view-card">
          <h3 class="text-sm font-semibold uppercase tracking-wide text-slate-400">Damage details</h3>
          <div class="mt-4 space-y-3">
            <div class="flex justify-between"><span class="text-slate-400">Vehicle damage</span><span class="job-damage-value">${formatter.format(Number(job.vehicle_damage ?? 0))}%</span></div>
            <div class="flex justify-between"><span class="text-slate-400">Trailer(s) damage</span><span class="job-damage-value">${formatter.format(Number(job.trailers_damage ?? 0))}%</span></div>
            <div class="flex justify-between"><span class="text-slate-400">Cargo damage</span><span class="job-damage-value">${formatter.format(Number(job.cargo_damage ?? 0))}%</span></div>
          </div>
        </article>
      </section>
    `;
  }

  async function loadJob() {
    const root = document.getElementById("job-root");
    const params = new URLSearchParams(window.location.search);
    const id = params.get("id");

    if (!id || !root) {
      if (root) root.innerHTML = `<p class="text-slate-400">No job ID provided.</p>`;
      return;
    }

    try {
      const response = await fetch(`/api/my-job?id=${encodeURIComponent(id)}`, { headers: getAuthHeaders() });
      const data = await response.json();

      if (!response.ok) {
        root.innerHTML = `<p class="text-rose-300">${data.error ?? "Could not load job."}</p>`;
        return;
      }

      const job = data.job as Record<string, unknown>;
      const events = Array.isArray(data.events) ? data.events : [];
      root.innerHTML = renderJob(job, events, data.driver?.name ?? "Driver");
    } catch {
      root.innerHTML = `<p class="text-rose-300">Could not reach the hub API.</p>`;
    }
  }

  onIdentityReady((user) => {
    if (user) loadJob();
  });
</script>
