---
import HubLayout from "../../layouts/HubLayout.astro";
---

<HubLayout
  title="Map"
  fullWidth={true}
  breadcrumbs={[{ label: "Home", href: "/hub/" }, { label: "Map" }]}
>
  <div class="px-6 pt-6">
    <h1 class="hub-page-title">Map</h1>
    <p class="mt-2 text-slate-400">TruckersMP live map — Simulation 1 (ETS2).</p>
  </div>
  <iframe
    class="hub-map-frame mt-4"
    src="https://map.truckersmp.com/?game=ets2&server=simulation1"
    title="TruckersMP Live Map — Simulation 1"
    loading="lazy"
    referrerpolicy="no-referrer-when-downgrade"
  ></iframe>
</HubLayout>
