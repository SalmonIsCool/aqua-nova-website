---
import HubLayout from "../../../layouts/HubLayout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const events = await getCollection("events");
  return events.map((event) => ({ params: { slug: event.id }, props: { event } }));
}

const { event } = Astro.props;
const { Content } = await render(event);
---

<HubLayout
  title={event.data.title}
  breadcrumbs={[
    { label: "Home", href: "/hub/" },
    { label: "Events", href: "/hub/events" },
    { label: event.data.title }
  ]}
>
  <article class="hub-event-card overflow-hidden lg:flex">
    <div class="flex h-56 w-full shrink-0 items-center justify-center bg-[#081638] text-7xl lg:h-auto lg:w-80">
      🚛
    </div>
    <div class="p-6 lg:p-8">
      <h1 class="hub-page-title">{event.data.title}</h1>
      <p class="mt-3 text-slate-400">
        {event.data.date.toLocaleString(undefined, {
          weekday: "long",
          year: "numeric",
          month: "long",
          day: "numeric",
          hour: "numeric",
          minute: "2-digit"
        })}
      </p>
      {event.data.endDate && (
        <p class="mt-1 text-sm text-slate-500">Ends {event.data.endDate.toLocaleString()}</p>
      )}
      {event.data.location && <p class="mt-2 text-cyan-300">{event.data.location}</p>}
      <p class="mt-4 text-slate-300">{event.data.excerpt}</p>
      <div class="prose prose-invert mt-6 max-w-none text-slate-300">
        <Content />
      </div>
    </div>
  </article>
</HubLayout>
