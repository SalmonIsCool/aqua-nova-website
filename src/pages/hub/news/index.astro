---
import HubLayout from "../../../layouts/HubLayout.astro";
import { getCollection } from "astro:content";

const news = (await getCollection("news")).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<HubLayout title="News" breadcrumbs={[{ label: "Home", href: "/hub/" }, { label: "News" }]}>
  <h1 class="hub-page-title">News</h1>

  <div class="mt-6 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
    {
      news.map((item) => (
        <article class="hub-news-card">
          <a href={`/hub/news/${item.id}`} class="block">
            <div class="hub-news-card__image">
              {item.data.coverImage ? (
                <img src={item.data.coverImage} alt="" loading="lazy" />
              ) : (
                <div class="flex h-full items-center justify-center bg-[#081638] text-5xl">📰</div>
              )}
              <div class="hub-news-card__overlay" />
              <p class="absolute bottom-3 left-3 right-3 text-lg font-bold text-white">{item.data.title}</p>
            </div>
            <div class="space-y-2 p-4">
              <div class="flex flex-wrap gap-4 text-xs text-slate-400">
                <span>Aqua Nova</span>
                <span>{item.data.date.toLocaleDateString()}</span>
              </div>
              <h2 class="text-lg font-semibold text-white">{item.data.title}</h2>
              <p class="text-sm text-slate-300">{item.data.excerpt}</p>
            </div>
          </a>
        </article>
      ))
    }
  </div>
</HubLayout>
