---
import HubLayout from "../../../layouts/HubLayout.astro";
import { driverRanks } from "../../../data/driver-ranks";
import { siteConfig } from "../../../data/site";

const ranks = [...driverRanks].reverse();
---

<HubLayout
  title="Driver Ranks"
  breadcrumbs={[
    { label: "Home", href: "/hub/" },
    { label: "Training", href: "/hub/training/driver-ranks" },
    { label: "Driver Ranks" }
  ]}
>
  <article class="hub-panel max-w-3xl">
    <h1 class="hub-page-title text-cyan-300">{siteConfig.name} Driver Ranks</h1>
    <p class="mt-4 text-slate-300">
      Ranks are assigned automatically in Trucky based on your total distance logged from completed jobs.
    </p>

    <h2 class="mt-8 text-lg font-semibold text-white">Driver ranks</h2>
    <ul class="mt-4 space-y-2">
      {
        ranks.map((rank) => (
          <li class={`flex items-center justify-between rounded-lg px-4 py-3 text-sm font-semibold text-white ${rank.color}`}>
            <span>{rank.name}</span>
            <span>{rank.minKm === 0 ? "0 km" : `${rank.minKm.toLocaleString("en-GB")} km`}</span>
          </li>
        ))
      }
    </ul>

    <h2 class="mt-8 text-lg font-semibold text-white">Staff ranks</h2>
    <p class="mt-3 text-slate-300">
      Management and staff roles sit above the driver rank ladder. Staff structure will be documented here.
    </p>
  </article>
</HubLayout>
