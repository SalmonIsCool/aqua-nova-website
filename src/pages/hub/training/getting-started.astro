---
import HubLayout from "../../../layouts/HubLayout.astro";
import { siteConfig } from "../../../data/site";

const truckyVtcUrl = "https://hub.truckyapp.com/company/46318";
---

<HubLayout
  title="Getting Started"
  breadcrumbs={[
    { label: "Home", href: "/hub/" },
    { label: "Training", href: "/hub/training/getting-started" },
    { label: "Getting Started" }
  ]}
>
  <article class="hub-panel max-w-3xl">
    <h1 class="hub-page-title">Welcome to {siteConfig.name} 👋</h1>
    <p class="mt-4 text-slate-300">
      Everything you need to get on the road with Aqua Nova — Trucky, your TruckersMP tag, company paint jobs, and how the
      Drivers Hub fits in.
    </p>

    <section class="mt-8 rounded-xl border border-white/10 bg-[#081638]/50 p-5 sm:p-6">
      <div class="flex flex-col gap-5 sm:flex-row sm:items-start">
        <img
          src="/assets/trucky-logo.png"
          alt="Trucky"
          width="72"
          height="72"
          class="h-[4.5rem] w-[4.5rem] shrink-0 rounded-xl shadow-lg shadow-rose-950/40"
        />
        <div class="min-w-0 space-y-4 text-slate-300">
          <h2 class="text-xl font-semibold text-white">Trucky VTC</h2>
          <p>
            When your application was accepted, your recruiter should have invited you to join the{" "}
            <a
              href={truckyVtcUrl}
              target="_blank"
              rel="noreferrer"
              class="font-semibold text-cyan-300 underline decoration-cyan-400/40 underline-offset-2 transition hover:text-cyan-200"
            >
              Trucky VTC
            </a>
            . If you were not invited, please contact your recruiter or{" "}
            <a
              href={siteConfig.discordInvite}
              target="_blank"
              rel="noreferrer"
              class="font-semibold text-cyan-300 underline decoration-cyan-400/40 underline-offset-2 transition hover:text-cyan-200"
            >
              open a support ticket on Discord
            </a>
            .
          </p>
          <p class="rounded-lg border border-cyan-400/20 bg-cyan-950/30 px-4 py-3 text-sm leading-relaxed text-slate-200">
            <strong class="text-white">It is mandatory</strong> to have Trucky open while driving for Aqua Nova
            Transport. Trucky tracks your jobs and sends them to the Drivers Hub — that is how we record your distance,
            deliveries, rank progress, and leaderboard stats.
          </p>
        </div>
      </div>
    </section>

    <section class="mt-8 rounded-xl border border-white/10 bg-[#081638]/50 p-5 sm:p-6">
      <h2 class="text-xl font-semibold text-white">TMP tag</h2>
      <p class="mt-4 text-slate-300">
        Your in-game tag should <strong class="text-white">match</strong> the settings below using the{" "}
        <strong class="text-white">same colour</strong>. If you do not know how to change your tag, press{" "}
        <kbd class="rounded border border-white/15 bg-[#0c1f4f] px-1.5 py-0.5 text-xs font-semibold text-cyan-200">Tab</kbd>{" "}
        when inside your truck and click the <strong class="text-white">settings</strong> icon in the{" "}
        <strong class="text-white">bottom left</strong>.
      </p>

      <dl class="mt-5 grid gap-3 rounded-lg border border-white/10 bg-[#0c1f4f]/60 p-4 text-sm sm:grid-cols-2">
        <div>
          <dt class="text-slate-400">Tag</dt>
          <dd class="mt-1 font-semibold text-white">{siteConfig.name}</dd>
        </div>
        <div class="flex items-end gap-3">
          <div>
            <dt class="text-slate-400">Colour (RGB)</dt>
            <dd class="mt-1 font-mono text-cyan-300">R 0 · G 212 · B 245</dd>
          </div>
          <span
            class="mb-0.5 h-8 w-8 shrink-0 rounded-md border border-white/20 shadow-inner"
            style="background-color: rgb(0, 212, 245)"
            title="Aqua Nova tag colour"
            aria-hidden="true"
          ></span>
        </div>
      </dl>

      <div class="mt-5 grid gap-4 sm:grid-cols-2">
        <figure class="overflow-hidden rounded-lg border border-white/10 bg-[#0c1f4f]/40">
          <img
            src="/assets/tmp-tag-settings.png"
            alt="TruckersMP tag settings showing Aqua Nova Transport and the company colour"
            class="h-full w-full object-cover object-top"
            loading="lazy"
          />
          <figcaption class="border-t border-white/10 px-3 py-2 text-xs text-slate-400">Tag &amp; colour in TMP settings</figcaption>
        </figure>
        <figure class="overflow-hidden rounded-lg border border-white/10 bg-[#0c1f4f]/40">
          <img
            src="/assets/tmp-tag-color-picker.png"
            alt="TruckersMP colour picker set to R 0, G 212, B 245"
            class="h-full w-full object-cover object-left-top"
            loading="lazy"
          />
          <figcaption class="border-t border-white/10 px-3 py-2 text-xs text-slate-400">RGB values in the colour picker</figcaption>
        </figure>
      </div>
    </section>

    <section class="mt-8 rounded-xl border border-white/10 bg-[#081638]/50 p-5 sm:p-6">
      <h2 class="text-xl font-semibold text-white">Truck paint job</h2>
      <p class="mt-4 text-slate-300">
        Here you can find the paint job for your truck. Select <strong class="text-white">Blade</strong> in the
        customisation menu and set each colour slot to match the RGB values below.
      </p>

      <dl class="mt-5 space-y-3 rounded-lg border border-white/10 bg-[#0c1f4f]/60 p-4 text-sm">
        <div>
          <dt class="text-slate-400">Paint job</dt>
          <dd class="mt-1 font-semibold text-white">Blade</dd>
        </div>
        <div class="grid gap-3 sm:grid-cols-2">
          <div class="flex items-center justify-between gap-3 rounded-lg border border-white/10 bg-[#081638]/50 px-3 py-2.5">
            <div>
              <dt class="text-slate-400">Colour 1</dt>
              <dd class="mt-0.5 font-mono text-cyan-300">R 19 · G 100 · B 147</dd>
            </div>
            <span
              class="h-8 w-8 shrink-0 rounded-md border border-white/20"
              style="background-color: rgb(19, 100, 147)"
              title="Colour 1"
              aria-hidden="true"
            ></span>
          </div>
          <div class="flex items-center justify-between gap-3 rounded-lg border border-white/10 bg-[#081638]/50 px-3 py-2.5">
            <div>
              <dt class="text-slate-400">Colour 2 + 3</dt>
              <dd class="mt-0.5 font-mono text-cyan-300">R 10 · G 181 · B 226</dd>
            </div>
            <span
              class="h-8 w-8 shrink-0 rounded-md border border-white/20"
              style="background-color: rgb(10, 181, 226)"
              title="Colour 2 and 3"
              aria-hidden="true"
            ></span>
          </div>
          <div class="flex items-center justify-between gap-3 rounded-lg border border-white/10 bg-[#081638]/50 px-3 py-2.5 sm:col-span-2">
            <div>
              <dt class="text-slate-400">Colour 4</dt>
              <dd class="mt-0.5 font-mono text-cyan-300">R 255 · G 255 · B 255</dd>
            </div>
            <span
              class="h-8 w-8 shrink-0 rounded-md border border-white/20"
              style="background-color: rgb(255, 255, 255)"
              title="Colour 4"
              aria-hidden="true"
            ></span>
          </div>
        </div>
      </dl>

      <div class="mt-5 grid gap-4 sm:grid-cols-2">
        <figure class="overflow-hidden rounded-lg border border-white/10 bg-[#0c1f4f]/40">
          <img
            src="/assets/paintjob-blade.png"
            alt="Blade paint job selected in the truck customisation menu"
            class="h-full w-full object-cover object-top"
            loading="lazy"
          />
          <figcaption class="border-t border-white/10 px-3 py-2 text-xs text-slate-400">Blade paint job in-game</figcaption>
        </figure>
        <figure class="overflow-hidden rounded-lg border border-white/10 bg-[#0c1f4f]/40">
          <img
            src="/assets/paintjob-blade-colors.png"
            alt="Blade paint job colour slots set to Aqua Nova company colours"
            class="h-full w-full object-cover object-left-top"
            loading="lazy"
          />
          <figcaption class="border-t border-white/10 px-3 py-2 text-xs text-slate-400">Company colours applied</figcaption>
        </figure>
      </div>
    </section>

    <section class="mt-8 rounded-xl border border-white/10 bg-[#081638]/50 p-5 sm:p-6">
      <h2 class="text-xl font-semibold text-white">Trailer paint job</h2>
      <p class="mt-4 text-slate-300">
        Here you can find the paint job for your trailer. Select <strong class="text-white">Duellist</strong> in the
        customisation menu and set each colour slot to match the RGB values below.
      </p>

      <dl class="mt-5 space-y-3 rounded-lg border border-white/10 bg-[#0c1f4f]/60 p-4 text-sm">
        <div>
          <dt class="text-slate-400">Paint job</dt>
          <dd class="mt-1 font-semibold text-white">Duellist</dd>
        </div>
        <div class="grid gap-3 sm:grid-cols-2">
          <div class="flex items-center justify-between gap-3 rounded-lg border border-white/10 bg-[#081638]/50 px-3 py-2.5">
            <div>
              <dt class="text-slate-400">Colour 1 (dark blue)</dt>
              <dd class="mt-0.5 font-mono text-cyan-300">R 19 · G 100 · B 147</dd>
            </div>
            <span
              class="h-8 w-8 shrink-0 rounded-md border border-white/20"
              style="background-color: rgb(19, 100, 147)"
              title="Colour 1"
              aria-hidden="true"
            ></span>
          </div>
          <div class="flex items-center justify-between gap-3 rounded-lg border border-white/10 bg-[#081638]/50 px-3 py-2.5">
            <div>
              <dt class="text-slate-400">Colour 2 (light blue)</dt>
              <dd class="mt-0.5 font-mono text-cyan-300">R 10 · G 181 · B 226</dd>
            </div>
            <span
              class="h-8 w-8 shrink-0 rounded-md border border-white/20"
              style="background-color: rgb(10, 181, 226)"
              title="Colour 2"
              aria-hidden="true"
            ></span>
          </div>
        </div>
      </dl>

      <div class="mt-5 grid gap-4 sm:grid-cols-2">
        <figure class="overflow-hidden rounded-lg border border-white/10 bg-[#0c1f4f]/40">
          <img
            src="/assets/paintjob-duellist.png"
            alt="Duellist trailer paint job selected in the customisation menu"
            class="h-full w-full object-cover object-top"
            loading="lazy"
          />
          <figcaption class="border-t border-white/10 px-3 py-2 text-xs text-slate-400">Duellist paint job in-game</figcaption>
        </figure>
        <figure class="overflow-hidden rounded-lg border border-white/10 bg-[#0c1f4f]/40">
          <img
            src="/assets/paintjob-duellist-colors.png"
            alt="Duellist trailer paint job colours set to Aqua Nova company colours"
            class="h-full w-full object-cover object-left-top"
            loading="lazy"
          />
          <figcaption class="border-t border-white/10 px-3 py-2 text-xs text-slate-400">Company colours applied</figcaption>
        </figure>
      </div>
    </section>

    <section class="mt-8 space-y-4 text-slate-300">
      <h2 class="text-xl font-semibold text-white">What to expect next</h2>
      <ul class="list-disc space-y-2 pl-5">
        <li>Joining convoys and company events</li>
        <li>Understanding driver ranks and company stats in the Drivers Hub</li>
        <li>Where to get help from staff and other drivers</li>
      </ul>
    </section>
  </article>
</HubLayout>
