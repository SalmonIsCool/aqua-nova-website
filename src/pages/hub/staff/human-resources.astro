---
import HubLayout from "../../../layouts/HubLayout.astro";
import StaffApplicationForm from "../../../components/hub/StaffApplicationForm.astro";
import { staffRoles } from "../../../data/staff-roles";

const role = staffRoles.find((item) => item.slug === "human-resources")!;
---

<HubLayout
  title="Human Resources"
  breadcrumbs={[
    { label: "Home", href: "/hub/" },
    { label: "Apply for staff", href: "/hub/staff" },
    { label: "Human Resources" }
  ]}
>
  <h1 class="hub-page-title">Human Resources application</h1>
  <p class="mt-2 max-w-2xl text-slate-400">{role.description}</p>

  <div class="mt-6 max-w-2xl">
    <StaffApplicationForm
      roleTitle={role.title}
      formName={role.formName}
      applicationType={role.applicationType}
      fields={[
        { name: "name", label: "Full name" },
        { name: "email", label: "Email address", type: "email" },
        { name: "discord_username", label: "Discord username" },
        {
          name: "truckersmp_profile",
          label: "TruckersMP profile link",
          type: "url",
          placeholder: "https://truckersmp.com/user/..."
        },
        { name: "age", label: "Age", type: "number" },
        { name: "timezone", label: "Timezone", placeholder: "e.g. GMT+1" },
        {
          name: "moderation_experience",
          label: "Do you have moderation or community management experience?",
          type: "textarea",
          rows: 4
        },
        {
          name: "why_hr",
          label: "Why do you want to join the Human Resources team?",
          type: "textarea",
          rows: 4
        },
        {
          name: "availability",
          label: "How many hours per week can you dedicate to HR duties?",
          type: "text"
        },
        {
          name: "conflict_example",
          label: "Describe how you would handle a dispute between two drivers.",
          type: "textarea",
          rows: 5
        }
      ]}
    />
  </div>
</HubLayout>
