---
import HubLayout from "../../../layouts/HubLayout.astro";
import StaffApplicationForm from "../../../components/hub/StaffApplicationForm.astro";
import StaffRoleClosed from "../../../components/hub/StaffRoleClosed.astro";
import { staffRoles } from "../../../data/staff-roles";

const role = staffRoles.find((item) => item.slug === "recruitment")!;
---

<HubLayout
  title="Recruitment Team"
  breadcrumbs={[
    { label: "Home", href: "/hub/" },
    { label: "Apply for staff", href: "/hub/staff" },
    { label: "Recruitment Team" }
  ]}
>
  <h1 class="hub-page-title">Recruitment Team application</h1>
  <p class="mt-2 max-w-2xl text-slate-400">{role.description}</p>

  <div class="mt-6 max-w-2xl">
    {
      role.open ? (
        <StaffApplicationForm
      roleTitle={role.title}
      formName={role.formName}
      applicationType={role.applicationType}
      fields={[
        { name: "name", label: "Full name" },
        { name: "email", label: "Email address", type: "email" },
        { name: "discord_username", label: "Discord username" },
        {
          name: "truckersmp_profile",
          label: "TruckersMP profile link",
          type: "url",
          placeholder: "https://truckersmp.com/user/..."
        },
        {
          name: "recruitment_experience",
          label: "Have you reviewed applications or recruited members before? Tell us about it.",
          type: "textarea",
          rows: 4
        },
        {
          name: "application_approach",
          label: "How would you evaluate a new driver application fairly?",
          type: "textarea",
          rows: 5
        },
        {
          name: "onboarding_ideas",
          label: "How would you welcome and onboard a newly accepted driver?",
          type: "textarea",
          rows: 4
        },
        {
          name: "why_recruitment",
          label: "Why do you want to join the Recruitment Team?",
          type: "textarea",
          rows: 4
        },
        {
          name: "availability",
          label: "How often can you check and respond to applications?",
          type: "text"
        }
      ]}
        />
      ) : (
        <StaffRoleClosed roleTitle={role.title} />
      )
    }
  </div>
</HubLayout>
