---
import HubLayout from "../../layouts/HubLayout.astro";
import { getCollection } from "astro:content";

const news = (await getCollection("news"))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const now = new Date();
const events = (await getCollection("events"))
  .filter((event) => event.data.date.valueOf() >= now.valueOf())
  .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());

const upcomingEvent = events[0] ?? null;
---

<HubLayout title="Dashboard" breadcrumbs={[{ label: "Home", href: "/hub/" }, { label: "Dashboard" }]}>
  <div>
    <h1 class="hub-page-title" id="hub-greeting">Good evening, driver</h1>
    <p class="mt-1 text-sm text-slate-400" id="hub-datetime"></p>

    <section class="mt-6 grid gap-4 lg:grid-cols-3">
      <article class="hub-stat-card">
        <div class="hub-stat-card__icon">👥</div>
        <div>
          <p class="hub-stat-card__value" id="company-drivers">—</p>
          <p class="hub-stat-card__label">Drivers</p>
        </div>
      </article>
      <article class="hub-stat-card">
        <div class="hub-stat-card__icon">🚛</div>
        <div>
          <p class="hub-stat-card__value" id="company-jobs">—</p>
          <p class="hub-stat-card__label">Jobs</p>
        </div>
      </article>
      <article class="hub-stat-card">
        <div class="hub-stat-card__icon">🛣</div>
        <div>
          <p class="hub-stat-card__value" id="company-miles">—</p>
          <p class="hub-stat-card__label">Miles</p>
        </div>
      </article>
    </section>

    <section class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <article class="hub-mini-stat">
        <p class="text-2xl">🚛</p>
        <p class="mt-2 text-xl font-bold text-white" id="stat-jobs">—</p>
        <p class="text-sm text-slate-400">Jobs</p>
      </article>
      <article class="hub-mini-stat">
        <p class="text-2xl">🛣</p>
        <p class="mt-2 text-xl font-bold text-white" id="stat-distance">—</p>
        <p class="text-sm text-slate-400">Miles</p>
      </article>
      <article class="hub-mini-stat">
        <p class="text-2xl">📅</p>
        <p class="mt-2 text-xl font-bold text-white" id="stat-events">0</p>
        <p class="text-sm text-slate-400">Events attended</p>
      </article>
      <article class="hub-mini-stat">
        <p class="text-2xl">💰</p>
        <p class="mt-2 text-xl font-bold text-white" id="stat-revenue">—</p>
        <p class="text-sm text-slate-400">Revenue</p>
      </article>
    </section>

    <section class="mt-6 grid gap-6 lg:grid-cols-3">
      <div class="space-y-6 lg:col-span-2">
        <article class="hub-panel">
          <h2 class="text-lg font-semibold text-white">Progress</h2>
          <div class="mt-5 space-y-5">
            <div>
              <div class="flex justify-between text-sm">
                <span class="text-slate-400">Monthly distance goal</span>
                <span class="text-slate-300" id="progress-distance-label">—</span>
              </div>
              <div class="hub-progress mt-2">
                <div class="hub-progress__bar" id="progress-distance" style="width: 0%"></div>
              </div>
            </div>
            <div>
              <div class="flex justify-between text-sm">
                <span class="text-slate-400">Monthly jobs goal</span>
                <span class="text-slate-300" id="progress-jobs-label">—</span>
              </div>
              <div class="hub-progress mt-2">
                <div class="hub-progress__bar" id="progress-jobs" style="width: 0%"></div>
              </div>
            </div>
          </div>
        </article>

        <article class="hub-panel">
          <h2 class="text-lg font-semibold text-white">Latest news</h2>
          <div class="mt-4 grid gap-4 md:grid-cols-3">
            {
              news.map((item) => (
                <a href={`/hub/news/${item.id}`} class="hub-news-card group">
                  <div class="hub-news-card__image">
                    {item.data.coverImage ? (
                      <img src={item.data.coverImage} alt="" loading="lazy" />
                    ) : (
                      <div class="flex h-full items-center justify-center bg-[#081638] text-4xl">📰</div>
                    )}
                    <div class="hub-news-card__overlay" />
                  </div>
                  <div class="p-4">
                    <p class="font-semibold text-white group-hover:text-cyan-300">{item.data.title}</p>
                    <p class="mt-1 text-xs text-slate-400">{item.data.date.toLocaleDateString()}</p>
                  </div>
                </a>
              ))
            }
          </div>
        </article>
      </div>

      <div class="space-y-6">
        <article class="hub-panel">
          <h2 class="text-lg font-semibold text-white">Recent activity</h2>
          <ul class="mt-4 space-y-3" id="recent-activity">
            <li class="text-sm text-slate-400">Loading…</li>
          </ul>
        </article>

        <article class="hub-panel">
          <h2 class="text-lg font-semibold text-white">Upcoming event</h2>
          {
            upcomingEvent ? (
              <div class="mt-4">
                <p class="text-sm text-cyan-300" id="upcoming-countdown"></p>
                <p class="mt-2 font-semibold text-white">{upcomingEvent.data.title}</p>
                <p class="mt-1 text-sm text-slate-400">
                  {upcomingEvent.data.date.toLocaleString()}
                  {upcomingEvent.data.location ? ` · ${upcomingEvent.data.location}` : ""}
                </p>
                <p class="mt-3 text-sm text-slate-300">{upcomingEvent.data.excerpt}</p>
                <a href={`/hub/events/${upcomingEvent.id}`} class="mt-4 inline-flex text-sm font-semibold text-cyan-300 hover:text-cyan-200">
                  View more →
                </a>
              </div>
            ) : (
              <p class="mt-4 text-sm text-slate-400">No upcoming events scheduled.</p>
            )
          }
        </article>
      </div>
    </section>
  </div>
</HubLayout>

<script define:vars={{ upcomingEventDate: upcomingEvent?.data.date.toISOString() ?? null }}>
  import { getAuthHeaders, onIdentityReady } from "../../scripts/hub-auth";

  const formatter = new Intl.NumberFormat("en-GB", { notation: "compact", maximumFractionDigits: 1 });
  const fullFormatter = new Intl.NumberFormat("en-GB");

  function greeting() {
    const hour = new Date().getHours();
    if (hour < 12) return "Good morning";
    if (hour < 18) return "Good afternoon";
    return "Good evening";
  }

  function setProgress(current, goal, barId, labelId, unit) {
    const pct = Math.min(Math.round((current / goal) * 100), 100);
    const remaining = Math.max(goal - current, 0);
    document.getElementById(barId).style.width = `${pct}%`;
    document.getElementById(labelId).textContent =
      remaining > 0 ? `${fullFormatter.format(remaining)} ${unit} remaining (${pct}%)` : `Goal reached (${pct}%)`;
  }

  function formatCountdown(targetIso) {
    const diff = new Date(targetIso).getTime() - Date.now();
    if (diff <= 0) return "Starting soon";
    const hours = Math.floor(diff / 3_600_000);
    const days = Math.floor(hours / 24);
    if (days > 0) return `in ${days} day${days === 1 ? "" : "s"}`;
    return `in ${hours} hour${hours === 1 ? "" : "s"}`;
  }

  async function loadDashboard() {
    const greetingEl = document.getElementById("hub-greeting");
    const datetimeEl = document.getElementById("hub-datetime");
    const activityEl = document.getElementById("recent-activity");

    if (datetimeEl) {
      datetimeEl.textContent = new Date().toLocaleString(undefined, {
        month: "long",
        day: "numeric",
        hour: "numeric",
        minute: "2-digit"
      });
    }

    if (upcomingEventDate) {
      const countdown = document.getElementById("upcoming-countdown");
      if (countdown) countdown.textContent = formatCountdown(upcomingEventDate);
    }

    try {
      const [statsRes, leaderboardRes, jobsRes] = await Promise.all([
        fetch("/api/my-stats", { headers: getAuthHeaders() }),
        fetch("/api/leaderboard"),
        fetch("/api/company-jobs?page=1", { headers: getAuthHeaders() })
      ]);

      const statsData = await statsRes.json();
      const leaderboardData = await leaderboardRes.json();
      const jobsData = await jobsRes.json();

      if (statsRes.ok) {
        const name = statsData.driver?.name ?? "driver";
        if (greetingEl) greetingEl.textContent = `${greeting()}, ${name}`;

        const stats = statsData.stats ?? {};
        const distanceKm = stats.drivenDistanceKm ?? 0;
        const jobs = stats.jobs ?? 0;
        const distanceMi = Math.round(distanceKm * 0.621371);

        document.getElementById("stat-jobs").textContent = fullFormatter.format(jobs);
        document.getElementById("stat-distance").textContent = fullFormatter.format(distanceMi);
        document.getElementById("stat-revenue").textContent = `€${fullFormatter.format(stats.revenue ?? 0)}`;

        setProgress(distanceMi, 5000, "progress-distance", "progress-distance-label", "mi");
        setProgress(jobs, 50, "progress-jobs", "progress-jobs-label", "jobs");
      }

      if (leaderboardRes.ok) {
        const drivers = Array.isArray(leaderboardData.drivers) ? leaderboardData.drivers : [];
        const totalJobs = drivers.reduce((sum, d) => sum + (d.jobs ?? 0), 0);
        const totalKm = drivers.reduce((sum, d) => sum + (d.drivenDistanceKm ?? 0), 0);
        const totalMi = Math.round(totalKm * 0.621371);

        document.getElementById("company-drivers").textContent = fullFormatter.format(drivers.length);
        document.getElementById("company-jobs").textContent = formatter.format(totalJobs);
        document.getElementById("company-miles").textContent = formatter.format(totalMi);
      }

      if (jobsRes.ok && activityEl) {
        const jobs = (jobsData.jobs ?? []).slice(0, 5);
        if (!jobs.length) {
          activityEl.innerHTML = `<li class="text-sm text-slate-400">No recent company jobs.</li>`;
        } else {
          activityEl.innerHTML = jobs
            .map(
              (job) => `
              <li class="flex items-start justify-between gap-3 text-sm">
                <div>
                  <p class="font-medium text-white">Job delivered</p>
                  <p class="text-slate-400">${job.driver} · ${fullFormatter.format(Math.round(job.distance * 0.621371))} mi</p>
                </div>
                <span class="shrink-0 text-slate-500">${job.date ? new Date(job.date).toLocaleTimeString([], { hour: "numeric", minute: "2-digit" }) : ""}</span>
              </li>`
            )
            .join("");
        }
      }
    } catch {
      if (activityEl) activityEl.innerHTML = `<li class="text-sm text-rose-300">Could not load dashboard data.</li>`;
    }
  }

  onIdentityReady((user) => {
    if (user) loadDashboard();
  });
</script>
