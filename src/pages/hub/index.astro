---
import HubLayout from "../../layouts/HubLayout.astro";
---

<HubLayout title="Dashboard">
  <div>
    <h1 class="section-title">My dashboard</h1>
    <p id="hub-greeting" class="mt-3 text-slate-300">Loading your profile…</p>

    <div id="hub-status" class="mt-4 text-sm text-slate-400"></div>

    <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      <article class="panel">
        <p class="text-sm text-slate-400">Distance (this month)</p>
        <p id="stat-distance" class="mt-2 text-2xl font-bold text-cyan-300">—</p>
      </article>
      <article class="panel">
        <p class="text-sm text-slate-400">Jobs completed</p>
        <p id="stat-jobs" class="mt-2 text-2xl font-bold text-cyan-300">—</p>
      </article>
      <article class="panel">
        <p class="text-sm text-slate-400">Cargo mass</p>
        <p id="stat-cargo" class="mt-2 text-2xl font-bold text-cyan-300">—</p>
      </article>
      <article class="panel">
        <p class="text-sm text-slate-400">Revenue</p>
        <p id="stat-revenue" class="mt-2 text-2xl font-bold text-cyan-300">—</p>
      </article>
    </div>

    <div class="mt-8">
      <a href="/hub/jobs" class="btn-primary">View my jobs</a>
    </div>
  </div>
</HubLayout>

<script>
  const formatter = new Intl.NumberFormat("en-GB");

  async function loadDashboard() {
    const greeting = document.getElementById("hub-greeting");
    const status = document.getElementById("hub-status");
    const user = window.netlifyIdentity?.currentUser();

    if (!user) return;

    if (greeting) {
      greeting.textContent = `Welcome back, ${user.user_metadata?.full_name || user.email}.`;
    }

    try {
      const response = await fetch("/api/my-stats", {
        headers: {
          Authorization: `Bearer ${user.token.access_token}`
        }
      });
      const data = await response.json();

      if (!response.ok) {
        if (status) status.textContent = data.error ?? "Could not load your stats.";
        return;
      }

      const stats = data.stats ?? {};
      document.getElementById("stat-distance")!.textContent = `${formatter.format(stats.drivenDistanceKm ?? 0)} km`;
      document.getElementById("stat-jobs")!.textContent = formatter.format(stats.jobs ?? 0);
      document.getElementById("stat-cargo")!.textContent = `${formatter.format(stats.cargoMass ?? 0)} kg`;
      document.getElementById("stat-revenue")!.textContent = `€${formatter.format(stats.revenue ?? 0)}`;

      if (status) {
        status.textContent = `Stats for ${data.month}/${data.year} from Trucky VTC Hub.`;
      }
    } catch {
      if (status) status.textContent = "Could not reach the hub API.";
    }
  }

  window.netlifyIdentity?.on("init", (user) => {
    if (user) loadDashboard();
  });

  if (window.netlifyIdentity?.currentUser()) {
    loadDashboard();
  }
</script>
