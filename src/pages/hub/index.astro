---
import HubLayout from "../../layouts/HubLayout.astro";
import { getCollection } from "astro:content";

const news = (await getCollection("news"))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const now = new Date();
const events = (await getCollection("events"))
  .filter((event) => event.data.date.valueOf() >= now.valueOf())
  .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());

const upcomingEvent = events[0] ?? null;
---

<HubLayout title="Dashboard" breadcrumbs={[{ label: "Home", href: "/hub/" }, { label: "Dashboard" }]}>
  <div
    id="hub-dashboard"
    data-upcoming-event={upcomingEvent?.data.date.toISOString() ?? ""}
  >
    <h1 class="hub-page-title" id="hub-greeting">Good evening, driver</h1>
    <p class="mt-1 text-sm text-slate-400" id="hub-datetime"></p>
    <p id="hub-dashboard-status" class="mt-2 hidden text-sm text-rose-300"></p>

    <section class="mt-6">
      <h2 class="hub-stats-heading">Company stats</h2>
      <div class="mt-3 grid gap-4 lg:grid-cols-3">
      <article class="hub-stat-card">
        <div class="hub-stat-card__icon">👥</div>
        <div>
          <p class="hub-stat-card__value" id="company-drivers">—</p>
          <p class="hub-stat-card__label">Drivers</p>
        </div>
      </article>
      <article class="hub-stat-card">
        <div class="hub-stat-card__icon">🚛</div>
        <div>
          <p class="hub-stat-card__value" id="company-jobs">—</p>
          <p class="hub-stat-card__label">Jobs</p>
        </div>
      </article>
      <article class="hub-stat-card">
        <div class="hub-stat-card__icon">🛣</div>
        <div>
          <p class="hub-stat-card__value" id="company-distance">—</p>
          <p class="hub-stat-card__label">Km</p>
        </div>
      </article>
      </div>
    </section>

    <section class="mt-6">
      <h2 class="hub-stats-heading">Personal stats</h2>
      <div class="mt-3 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <article class="hub-mini-stat">
        <p class="text-2xl">🚛</p>
        <p class="mt-2 text-xl font-bold text-white" id="stat-jobs">—</p>
        <p class="text-sm text-slate-400">Jobs</p>
      </article>
      <article class="hub-mini-stat">
        <p class="text-2xl">🛣</p>
        <p class="mt-2 text-xl font-bold text-white" id="stat-distance">—</p>
        <p class="text-sm text-slate-400">Km</p>
      </article>
      <article class="hub-mini-stat">
        <p class="text-2xl">📅</p>
        <p class="mt-2 text-xl font-bold text-white" id="stat-events">0</p>
        <p class="text-sm text-slate-400">Events attended</p>
      </article>
      <article class="hub-mini-stat">
        <p class="text-2xl">💰</p>
        <p class="mt-2 text-xl font-bold text-white" id="stat-revenue">—</p>
        <p class="text-sm text-slate-400">Revenue</p>
      </article>
      </div>
    </section>

    <section class="mt-6 grid gap-6 lg:grid-cols-3">
      <div class="space-y-6 lg:col-span-2">
        <article class="hub-panel">
          <h2 class="text-lg font-semibold text-white">Rank progress</h2>
          <div class="mt-5 grid gap-4 sm:grid-cols-2">
            <div class="rounded-xl border border-white/10 bg-[#081638]/60 p-4">
              <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Current rank</p>
              <p class="hub-rank-pill mt-3" id="rank-current">—</p>
              <p class="mt-3 text-sm text-slate-400">
                <span id="rank-total-km">—</span> km logged
              </p>
            </div>
            <div class="rounded-xl border border-white/10 bg-[#081638]/60 p-4">
              <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Next rank</p>
              <p class="hub-rank-pill mt-3" id="rank-next">—</p>
              <p class="mt-3 text-sm text-slate-400" id="rank-remaining-label">—</p>
            </div>
          </div>
          <div class="mt-5">
            <div class="flex justify-between text-sm">
              <span class="text-slate-400">Progress to next rank</span>
              <span class="text-slate-300" id="rank-progress-label">—</span>
            </div>
            <div class="hub-progress mt-2">
              <div class="hub-progress__bar" id="rank-progress-bar" style="width: 0%"></div>
            </div>
          </div>
        </article>

        <article class="hub-panel">
          <h2 class="text-lg font-semibold text-white">Latest news</h2>
          <div class="mt-4 grid gap-4 md:grid-cols-3">
            {
              news.map((item) => (
                <a href={`/hub/news/${item.id}`} class="hub-news-card group">
                  <div class="hub-news-card__image">
                    {item.data.coverImage ? (
                      <img src={item.data.coverImage} alt="" loading="lazy" />
                    ) : (
                      <div class="flex h-full items-center justify-center bg-[#081638] text-4xl">📰</div>
                    )}
                    <div class="hub-news-card__overlay" />
                  </div>
                  <div class="p-4">
                    <p class="font-semibold text-white group-hover:text-cyan-300">{item.data.title}</p>
                    <p class="mt-1 text-xs text-slate-400">{item.data.date.toLocaleDateString()}</p>
                  </div>
                </a>
              ))
            }
          </div>
        </article>
      </div>

      <div class="space-y-6">
        <article class="hub-panel">
          <h2 class="text-lg font-semibold text-white">Recent activity</h2>
          <ul class="mt-4 space-y-3" id="recent-activity">
            <li class="text-sm text-slate-400">Loading…</li>
          </ul>
        </article>

        <article class="hub-panel">
          <h2 class="text-lg font-semibold text-white">Upcoming event</h2>
          {
            upcomingEvent ? (
              <div class="mt-4">
                <p class="text-sm text-cyan-300" id="upcoming-countdown"></p>
                <p class="mt-2 font-semibold text-white">{upcomingEvent.data.title}</p>
                <p class="mt-1 text-sm text-slate-400">
                  {upcomingEvent.data.date.toLocaleString()}
                  {upcomingEvent.data.location ? ` · ${upcomingEvent.data.location}` : ""}
                </p>
                <p class="mt-3 text-sm text-slate-300">{upcomingEvent.data.excerpt}</p>
                <a href={`/hub/events/${upcomingEvent.id}`} class="mt-4 inline-flex text-sm font-semibold text-cyan-300 hover:text-cyan-200">
                  View more →
                </a>
              </div>
            ) : (
              <p class="mt-4 text-sm text-slate-400">No upcoming events scheduled.</p>
            )
          }
        </article>
      </div>
    </section>
  </div>
</HubLayout>

<script>
  import { getAuthHeadersAsync, onIdentityReady } from "../../scripts/hub-auth";

  const formatter = new Intl.NumberFormat("en-GB", { notation: "compact", maximumFractionDigits: 1 });
  const fullFormatter = new Intl.NumberFormat("en-GB");

  function greeting() {
    const hour = new Date().getHours();
    if (hour < 12) return "Good morning";
    if (hour < 18) return "Good afternoon";
    return "Good evening";
  }

  function applyRankPill(element: HTMLElement | null, name: string, color: string) {
    if (!element) return;
    element.textContent = name;
    element.style.color = color;
    element.style.borderColor = `${color}66`;
    element.style.backgroundColor = `${color}22`;
  }

  function renderRankProgress(rank: {
    currentName: string;
    currentColor: string;
    nextName: string | null;
    nextColor: string | null;
    totalDistanceKm: number;
    progressPercent: number;
    remainingKm: number;
  }) {
    const currentEl = document.getElementById("rank-current");
    const nextEl = document.getElementById("rank-next");
    const totalKmEl = document.getElementById("rank-total-km");
    const remainingLabel = document.getElementById("rank-remaining-label");
    const progressLabel = document.getElementById("rank-progress-label");
    const progressBar = document.getElementById("rank-progress-bar");
    const sidebarRank = document.getElementById("hub-sidebar-rank");

    applyRankPill(currentEl, rank.currentName, rank.currentColor);
    if (totalKmEl) totalKmEl.textContent = fullFormatter.format(rank.totalDistanceKm);
    if (sidebarRank) {
      sidebarRank.textContent = rank.currentName;
      sidebarRank.style.color = rank.currentColor;
    }

    if (!rank.nextName || !rank.nextColor) {
      applyRankPill(nextEl, "Max rank", rank.currentColor);
      if (remainingLabel) remainingLabel.textContent = "You have reached the highest driver rank.";
      if (progressLabel) progressLabel.textContent = "100%";
      if (progressBar) {
        progressBar.style.width = "100%";
        progressBar.style.background = rank.currentColor;
      }
      return;
    }

    applyRankPill(nextEl, rank.nextName, rank.nextColor);
    if (remainingLabel) {
      remainingLabel.textContent = `${fullFormatter.format(rank.remainingKm)} km remaining (${rank.progressPercent}%)`;
    }
    if (progressLabel) {
      progressLabel.textContent = `${rank.progressPercent}%`;
    }
    if (progressBar) {
      progressBar.style.width = `${rank.progressPercent}%`;
      progressBar.style.background = `linear-gradient(90deg, ${rank.currentColor}, ${rank.nextColor})`;
    }
  }

  function formatCountdown(targetIso: string) {
    const diff = new Date(targetIso).getTime() - Date.now();
    if (diff <= 0) return "Starting soon";
    const hours = Math.floor(diff / 3_600_000);
    const days = Math.floor(hours / 24);
    if (days > 0) return `in ${days} day${days === 1 ? "" : "s"}`;
    return `in ${hours} hour${hours === 1 ? "" : "s"}`;
  }

  function showDashboardError(message: string) {
    const statusEl = document.getElementById("hub-dashboard-status");
    if (statusEl) {
      statusEl.textContent = message;
      statusEl.classList.remove("hidden");
    }
  }

  async function loadDashboard() {
    const root = document.getElementById("hub-dashboard");
    const greetingEl = document.getElementById("hub-greeting");
    const datetimeEl = document.getElementById("hub-datetime");
    const activityEl = document.getElementById("recent-activity");
    const upcomingEventDate = root?.dataset.upcomingEvent ?? "";

    if (datetimeEl) {
      datetimeEl.textContent = new Date().toLocaleString(undefined, {
        month: "long",
        day: "numeric",
        hour: "numeric",
        minute: "2-digit"
      });
    }

    if (upcomingEventDate) {
      const countdown = document.getElementById("upcoming-countdown");
      if (countdown) countdown.textContent = formatCountdown(upcomingEventDate);
    }

    const errors: string[] = [];

    try {
      const leaderboardRes = await fetch("/api/leaderboard");
      const leaderboardData = await leaderboardRes.json();

      if (leaderboardRes.ok) {
        const drivers = Array.isArray(leaderboardData.drivers) ? leaderboardData.drivers : [];
        const totalJobs = drivers.reduce((sum: number, d: { jobs?: number }) => sum + (d.jobs ?? 0), 0);
        const totalKm = drivers.reduce(
          (sum: number, d: { drivenDistanceKm?: number }) => sum + (d.drivenDistanceKm ?? 0),
          0
        );

        const driversEl = document.getElementById("company-drivers");
        const jobsEl = document.getElementById("company-jobs");
        const distanceEl = document.getElementById("company-distance");
        if (driversEl) driversEl.textContent = fullFormatter.format(drivers.length);
        if (jobsEl) jobsEl.textContent = formatter.format(totalJobs);
        if (distanceEl) distanceEl.textContent = formatter.format(totalKm);
      } else {
        errors.push(leaderboardData.error ?? "Could not load company stats.");
      }

      const authHeaders = await getAuthHeadersAsync();
      const statsRes = await fetch("/api/my-stats", { headers: authHeaders });
      const statsData = await statsRes.json();

      if (statsRes.ok) {
        const name = statsData.driver?.name ?? "driver";
        if (greetingEl) greetingEl.textContent = `${greeting()}, ${name}`;

        const stats = statsData.stats ?? {};
        const distanceKm = stats.drivenDistanceKm ?? 0;
        const jobs = stats.jobs ?? 0;

        const statJobs = document.getElementById("stat-jobs");
        const statDistance = document.getElementById("stat-distance");
        const statRevenue = document.getElementById("stat-revenue");
        if (statJobs) statJobs.textContent = fullFormatter.format(jobs);
        if (statDistance) statDistance.textContent = fullFormatter.format(distanceKm);
        if (statRevenue) statRevenue.textContent = `€${fullFormatter.format(stats.revenue ?? 0)}`;

        if (statsData.rank) renderRankProgress(statsData.rank);
      } else {
        errors.push(statsData.error ?? "Could not load your stats.");
        if (greetingEl) greetingEl.textContent = `${greeting()}, driver`;
      }

      const jobsRes = await fetch("/api/company-jobs?page=1", { headers: authHeaders });
      const jobsData = await jobsRes.json();

      if (jobsRes.ok && activityEl) {
        const jobs = (jobsData.jobs ?? []).slice(0, 5);
        if (!jobs.length) {
          activityEl.innerHTML = `<li class="text-sm text-slate-400">No recent company jobs.</li>`;
        } else {
          activityEl.innerHTML = jobs
            .map(
              (job: { driver: string; distance: number; date: string | null }) => `
              <li class="flex items-start justify-between gap-3 text-sm">
                <div>
                  <p class="font-medium text-white">Job delivered</p>
                  <p class="text-slate-400">${job.driver} · ${fullFormatter.format(job.distance)} km</p>
                </div>
                <span class="shrink-0 text-slate-500">${job.date ? new Date(job.date).toLocaleTimeString([], { hour: "numeric", minute: "2-digit" }) : ""}</span>
              </li>`
            )
            .join("");
        }
      } else if (activityEl) {
        activityEl.innerHTML = `<li class="text-sm text-slate-400">Could not load recent activity.</li>`;
        if (!jobsRes.ok) errors.push(jobsData.error ?? "Could not load recent jobs.");
      }

      if (errors.length) showDashboardError([...new Set(errors)].join(" "));
    } catch {
      showDashboardError("Could not reach the hub API. Try refreshing the page.");
      if (activityEl) activityEl.innerHTML = `<li class="text-sm text-rose-300">Could not load dashboard data.</li>`;
    }
  }

  onIdentityReady((user) => {
    if (user) loadDashboard();
  });
</script>
