---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { siteConfig } from "../data/site";

const mediaItems = (await getCollection("media")).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title={`${siteConfig.name} | Media`}>
  <section class="section-shell">
    <h1 class="text-3xl font-bold">Media & Downloads</h1>
    <p class="mt-3 text-slate-300">Screenshots, videos, and shared resources from the team.</p>

    <div class="mt-8 grid gap-5 md:grid-cols-2">
      {
        mediaItems.map((item) => (
          <article class="panel">
            <p class="text-xs uppercase tracking-wide text-slate-400">{item.data.type}</p>
            <h2 class="mt-2 text-xl font-semibold text-cyan-300">{item.data.title}</h2>
            <p class="mt-2 text-slate-300">{item.data.excerpt}</p>
            {item.data.image && <img class="mt-4 h-44 w-full rounded-md object-cover" src={item.data.image} alt={item.data.title} />}
            {item.data.url && (
              <a href={item.data.url} class="mt-4 inline-flex text-sm font-semibold text-cyan-300 hover:text-cyan-200" target="_blank" rel="noreferrer">
                Open link
              </a>
            )}
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>
