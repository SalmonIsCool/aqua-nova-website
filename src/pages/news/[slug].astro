---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";
import { siteConfig } from "../../data/site";

export async function getStaticPaths() {
  const posts = await getCollection("news");
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={`${siteConfig.name} | ${post.data.title}`}>
  <article class="section-shell">
    <p class="text-sm text-slate-400">{post.data.date.toLocaleDateString()}</p>
    <h1 class="mt-2 text-3xl font-bold">{post.data.title}</h1>
    <div class="prose prose-invert mt-6 max-w-none">
      <Content />
    </div>
  </article>
</BaseLayout>
