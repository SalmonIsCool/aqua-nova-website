---
import BaseLayout from "../layouts/BaseLayout.astro";
import RequirementsCard from "../components/RequirementsCard.astro";
import { siteConfig } from "../data/site";
---

<BaseLayout title={`${siteConfig.name} | Apply`}>
  <section class="section-shell-wide">
    <h1 class="section-title">Apply to join</h1>
    <p class="mt-3 max-w-2xl text-base text-slate-300 sm:text-lg">
      Complete the form below after reading the requirements. Applications are reviewed regularly by staff.
    </p>
    <p class="mt-3 max-w-2xl text-sm text-slate-400">
      If accepted, staff will email you a <strong class="text-slate-300">Drivers Hub</strong> invite so you can set your
      own password. We only use email and password for the hub — never Discord or Steam logins.
    </p>

    <div class="mt-10 grid gap-8 lg:grid-cols-5 lg:gap-10">
      <div class="lg:col-span-2">
        <RequirementsCard />
      </div>

      <form
        name="apply"
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field"
        class="panel grid gap-5 lg:col-span-3"
      >
        <input type="hidden" name="form-name" value="apply" />
        <p class="hidden">
          <label>
            Do not fill this out if you are human: <input name="bot-field" />
          </label>
        </p>

        <label class="grid gap-2">
          <span class="text-sm font-medium text-slate-300">Name</span>
          <input required name="name" class="input-field" autocomplete="name" />
        </label>

        <label class="grid gap-2">
          <span class="text-sm font-medium text-slate-300">TruckersMP profile (link)</span>
          <input
            required
            type="url"
            name="truckersmp_profile"
            class="input-field"
            placeholder="https://truckersmp.com/user/12345/your-name"
          />
        </label>

        <label class="grid gap-2">
          <span class="text-sm font-medium text-slate-300">Discord username</span>
          <input
            required
            name="discord_username"
            class="input-field"
            placeholder="e.g. salmon"
            autocomplete="username"
          />
        </label>

        <label class="grid gap-2">
          <span class="text-sm font-medium text-slate-300">Age</span>
          <input required type="number" min="14" name="age" class="input-field" />
        </label>

        <label class="grid gap-2">
          <span class="text-sm font-medium text-slate-300">Timezone</span>
          <input required name="timezone" class="input-field" placeholder="e.g. GMT+1" />
        </label>

        <label class="grid gap-2">
          <span class="text-sm font-medium text-slate-300">Why do you want to join?</span>
          <textarea required name="reason" rows="5" class="input-field"></textarea>
        </label>

        <button type="submit" class="btn-primary w-full sm:w-fit">Submit application</button>
      </form>
    </div>
  </section>
</BaseLayout>
